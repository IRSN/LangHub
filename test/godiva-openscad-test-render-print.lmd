# Godiva Device OpenSCAD Test - Print Engine (for local testing)

This test file uses the print engine to simulate all three engines for testing without requiring actual LLM access.

## Ollama Generation

```print, log=output/godiva-ollama.log
// Godiva Device - Ollama Generated
// Parameters
core_length = 150;
core_width = 100;
core_height = 50;
wall_thickness = 3;

// Core Assembly Module
module core_assembly() {
    difference() {
        cube([core_length, core_width, core_height]);
        // Mounting holes
        translate([5, 5, -1])
            cylinder(h=core_height+2, d=4);
        translate([core_length-5, 5, -1])
            cylinder(h=core_height+2, d=4);
        translate([5, core_width-5, -1])
            cylinder(h=core_height+2, d=4);
        translate([core_length-5, core_width-5, -1])
            cylinder(h=core_height+2, d=4);
    }
}

// Housing Module
module housing() {
    clearance = 5;
    difference() {
        cube([core_length+clearance*2, core_width+clearance*2, core_height+20]);
        translate([wall_thickness, wall_thickness, wall_thickness])
            cube([core_length+clearance*2-wall_thickness*2, 
                  core_width+clearance*2-wall_thickness*2, 
                  core_height+20]);
    }
}

// Control Panel Module
module control_panel() {
    difference() {
        cube([core_width, 60, 3]);
        translate([10, 10, -1])
            cylinder(h=5, d=12);
        translate([core_width-10, 10, -1])
            cylinder(h=5, d=12);
    }
}

// Assembly
core_assembly();
```

## Claude Generation

```print, log=output/godiva-claude.log
// Godiva Device - Claude Generated
// Configuration
$fn = 50;

// Dimensions
CORE_DIM = [150, 100, 50];
HOUSING_CLEARANCE = 5;
PANEL_SIZE = [100, 60, 3];

// Core Module
module godiva_core(dim) {
    difference() {
        cube(dim);
        for (x = [5, dim[0]-5]) {
            for (y = [5, dim[1]-5]) {
                translate([x, y, -0.5])
                    cylinder(h=dim[2]+1, d=4);
            }
        }
    }
}

// Housing Module  
module godiva_housing(core_dim, clearance) {
    outer = [core_dim[0] + clearance*2, 
             core_dim[1] + clearance*2, 
             core_dim[2] + 20];
    difference() {
        cube(outer);
        translate([2.5, 2.5, 2.5])
            cube([outer[0]-5, outer[1]-5, outer[2]]);
        // Ventilation holes
        for (x = [10:10:outer[0]-10]) {
            for (y = [10:10:outer[1]-10]) {
                translate([x, y, -1])
                    cylinder(h=4, d=6);
            }
        }
    }
}

// Control Panel Module
module godiva_panel(size) {
    difference() {
        cube(size);
        translate([size[0]/2-20, size[1]/2, -1])
            cube([40, 20, size[2]+2]);
    }
}

// Instantiate
godiva_core(CORE_DIM);
```

## Copilot Generation

```print, log=output/godiva-copilot.log
// Godiva Device - Copilot Generated
// Design parameters
core_x = 150;
core_y = 100;
core_z = 50;
clearance = 5;
wall = 2.5;

// Main core assembly
module main_core() {
    difference() {
        cube([core_x, core_y, core_z]);
        // Create mounting holes at corners
        translate([5, 5, 0])
            cylinder(h=core_z, d=4, $fn=30);
        translate([core_x-5, 5, 0])
            cylinder(h=core_z, d=4, $fn=30);
        translate([5, core_y-5, 0])
            cylinder(h=core_z, d=4, $fn=30);
        translate([core_x-5, core_y-5, 0])
            cylinder(h=core_z, d=4, $fn=30);
    }
}

// Protective housing
module protective_housing() {
    h_x = core_x + clearance*2;
    h_y = core_y + clearance*2;
    h_z = core_z + 20;
    
    difference() {
        cube([h_x, h_y, h_z]);
        translate([wall, wall, wall])
            cube([h_x-wall*2, h_y-wall*2, h_z]);
    }
}

// Interface panel
module interface_panel() {
    panel_x = 100;
    panel_y = 60;
    panel_z = 3;
    
    difference() {
        cube([panel_x, panel_y, panel_z]);
        // Button holes
        translate([20, 30, -1])
            cylinder(h=panel_z+2, d=12, $fn=40);
        translate([panel_x-20, 30, -1])
            cylinder(h=panel_z+2, d=12, $fn=40);
        // Display cutout
        translate([panel_x/2-20, 10, -1])
            cube([40, 15, panel_z+2]);
    }
}

// Render
main_core();
```
